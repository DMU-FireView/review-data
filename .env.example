# ──────────────────────────────────────────────
# 공통 설정
# ──────────────────────────────────────────────
REQUEST_TIMEOUT=15        # HTTP 요청 타임아웃(초)
REQUEST_DELAY=1.0         # 연속 요청 사이 대기(초)
HEADLESS=true             # Playwright 브라우저 숨김 여부

# 로컬 Postgres 접속 정보 (docker run 등으로 직접 띄운 뒤 사용)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/review_data

# ──────────────────────────────────────────────
# 플랫폼별 인증 정보
#
# 규칙: 자기 플랫폼에 키가 필요하면
#   1) 이 파일에 빈 값으로 추가
#   2) core/settings.py 의 Settings 에 필드 추가
#   3) 본인 collector 의 required_settings 에 추가
# 세 곳 모두 반영해야 팀원들이 뭐가 필요한지 알 수 있습니다.
# ──────────────────────────────────────────────

# 네이버 검색 API (예시)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=


# 11번가 오픈 API (정빈)
ELEVENST_API_KEY=
